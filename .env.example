# Puerto en el que escucha el mock de proveedores.
PORT=4000

# API key que el banco tiene que mandar en el header x-api-key.
# No es un secreto real: esto es un mock. Se pide igual para que el código del
# banco maneje credenciales de proveedor como lo haría en producción.
PROVEEDORES_API_KEY=orbital-proveedores-2026

# Orígenes permitidos por CORS, separados por coma. * en desarrollo.
CORS_ORIGINS=*
